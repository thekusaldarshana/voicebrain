# ---------------------------------------------------------------- required
# Used by the recorder app to upload. Generate: openssl rand -hex 24
INGEST_TOKEN=

# Your timezone. Decides what "today" and "overdue" mean.
OWNER_TIMEZONE=Asia/Colombo

# ------------------------------------------------- the assistant (ChatGPT) over MCP
# The public https address of this server (what Caddy serves).
PUBLIC_URL=https://brain.example.com
# You type this once on the approval page when ChatGPT connects. 12+ characters. Not the same as INGEST_TOKEN.
OWNER_PASSPHRASE=
# Optional: a fixed token for MCP clients that cannot do OAuth (Claude Desktop, Cursor, curl). Generate: openssl rand -hex 24
MCP_TOKEN=

# Only let your recorder app (on Vercel) call the upload endpoint from a browser. Leave * while testing.
ALLOWED_ORIGIN=*

# ------------------------------------------------------- transcription: choose ONE
# A) Gemini (hosted, free tier). Tested. Several keys can be listed, comma separated: when one is rate limited the next is used.
STT_PROVIDER=gemini
STT_API_KEY=
STT_MODEL=gemini-3.5-transcribe
#   gemini-3.5-transcribe gives the cleanest text. A flash model (for example gemini-3.5-flash-lite) also returns
#   per-sentence timestamps, so marked moments can show the words spoken there.
# B) Groq (hosted, free tier, fast)
#STT_BASE_URL=https://api.groq.com/openai/v1
#STT_API_KEY=
#STT_MODEL=whisper-large-v3-turbo
# C) On this VPS (private, free): docker compose --profile local-stt up -d
#STT_BASE_URL=http://stt:8000/v1
#STT_API_KEY=unused
#STT_MODEL=Systran/faster-whisper-small.en
STT_LANGUAGE=en
# Words the recognizer often gets wrong (names, projects). Helps accuracy.
STT_PROMPT=

# ------------------------------------------- language model that extracts tasks and ideas
# Any OpenAI-compatible service. Pick a small, cheap model that can return JSON.
#   OpenAI      https://api.openai.com/v1
#   Groq        https://api.groq.com/openai/v1
#   OpenRouter  https://openrouter.ai/api/v1
#   Gemini      https://generativelanguage.googleapis.com/v1beta/openai   (tested with gemini-3.5-flash-lite)
# Several keys can be listed, comma separated. Check Google's current terms: on the free tier your content may be used to improve its products.
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-3.5-flash-lite

# ---------------------------------------------------------------- optional
#PUID=1000
#PGID=1000
#DATA_PATH=./data
#MAX_UPLOAD_MB=200
