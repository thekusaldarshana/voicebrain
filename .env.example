# ---------------------------------------------------------------- required
# Used by the recorder app to upload. Generate: openssl rand -hex 24
INGEST_TOKEN=

# Your timezone. Decides what "today" and "overdue" mean.
OWNER_TIMEZONE=Asia/Colombo

# ------------------------------------------------- the assistant (ChatGPT) over MCP
# The public https address of this server (what Caddy serves).
PUBLIC_URL=https://brain.example.com
# Sign-in is with Google. Create an OAuth client (type "Web application") in Google Cloud Console and add
# this authorized redirect URI:  <PUBLIC_URL>/auth/google/callback   Scopes used: openid, email, profile.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Who may sign in: a comma-separated list of Google email addresses. Leave empty and the FIRST person to
# sign in claims this server (everyone after them is refused), so set this before you publish the address.
ALLOWED_EMAILS=
# Optional: let each person connect their own Google Drive (permission: drive.file only).
# Needs the Drive API enabled in the same Google Cloud project, this extra redirect URI:
#   <PUBLIC_URL>/auth/drive/callback
# and the consent screen PUBLISHED ("Publish app"): in Testing mode Google expires every Drive
# refresh token after 7 days. The server refuses to start with DRIVE_ENABLED=1 and no key.
DRIVE_ENABLED=
# 32 random bytes, base64. Generate: openssl rand -base64 32. Keep it OUT of backups of ./data
# (the sealed tokens in data/drive.sqlite are useless without it). Lose it and everyone reconnects Drive.
TOKEN_ENCRYPTION_KEY=
# Legacy, only used while GOOGLE_CLIENT_ID is empty: a passphrase typed on the approval page (12+ characters).
OWNER_PASSPHRASE=
# Optional: a fixed token for MCP clients that cannot do OAuth (Claude Desktop, Cursor, curl). Generate: openssl rand -hex 24
MCP_TOKEN=

# Only let your recorder app (on Vercel) call the upload endpoint from a browser. Leave * while testing.
ALLOWED_ORIGIN=*

# ------------------------------------------------ transcription: Whisper on this VPS
# Runs in the `stt` container from compose.yaml. Audio never leaves your machine, and it costs nothing.
STT_BASE_URL=http://stt:8000/v1
# Label only; the real model is WHISPER_MODEL below, and notes record the one actually loaded.
STT_MODEL=large-v3-turbo
STT_LANGUAGE=en
# Names and terms Whisper mishears, comma separated. Fixes things like "Nimal" heard as "Nemo".
STT_PROMPT=Nimal, Trapper, voicebrain

# Measured on noisy and phone-quality audio (see server/README.md):
# large-v3-turbo    best value: close to large-v3's accuracy at about 3x the speed. ~3 GB of memory. Default.
# large-v3          most accurate, but about as slow as the recording (1x realtime on 4 shared vCPUs). ~4 GB.
# distil-large-v3   English only, ~2 GB; not better than turbo in the test.
# small.en          lightest (~1 GB) and fine on clean speech, but 28% errors on a phone call in traffic.
WHISPER_MODEL=large-v3-turbo
#WHISPER_THREADS=6          # default 6; lower it if the VPS runs other busy services

# ------------------- sorting notes into tasks, ideas and summaries
# Whisper (above) writes a note down. Something then has to read the words and pick out tasks and ideas. Three ways:
#   1. Nothing here: your assistant does it over MCP (ChatGPT, Claude Code, Cursor...), whenever you use it. No key needed.
#   2. An API key: the server sorts every note by itself, a minute after you record.
#   3. An agent program installed on this machine (Claude Code, Codex, opencode...): the same, using that program.
# Try your setting with:  docker compose exec voicebrain node src/main.ts llm-test
#
# --- 2a. Any OpenAI-compatible server: OpenAI, Groq, OpenRouter, Gemini's compatible endpoint, or a local Ollama.
#LLM_BASE_URL=https://api.openai.com/v1
#LLM_API_KEY=
#LLM_MODEL=
# --- 2b. Anthropic (Claude) API key:
#LLM_PROVIDER=anthropic
#LLM_API_KEY=
#LLM_MODEL=
# Several keys can be listed, comma separated; the next one is used when one is rate limited.
#
# --- 3. A local agent program. Presets: claude-code, codex, opencode (UNTESTED against the real programs: run llm-test).
#LLM_PROVIDER=claude-code
# or any program that reads a prompt on stdin and prints JSON, with its own arguments:
#LLM_PROVIDER=cli
#LLM_COMMAND=my-agent --quiet
# The program sees none of this file's secrets. To pass one it needs (for example its own API key), name it here:
#LLM_CLI_ENV=ANTHROPIC_API_KEY
# Tip: the program reads strangers' words. Keep its tools off and run it with no access to anything you care about.

# ---------------------------------------------------------------- optional
# Host port on 127.0.0.1 that your reverse proxy forwards to (port 8787 is used by another app on the VPS).
#VOICEBRAIN_PORT=18787
# Memory ceiling for the Whisper container. 5g suits large-v3-turbo; use 6g for large-v3.
#STT_MEM_LIMIT=5g
#PUID=1000
#PGID=1000
#DATA_PATH=./data
#MAX_UPLOAD_MB=200
